TD_cabin_tb.random_cabin_press ;
    %vpi_func 2 279 "$urandom_range" 32, 32'sb00000000000000000000000000000000, P_0000017710885010 {0 0 0};
    %store/vec4 v0000017710878bf0_0, 0, 32;
    %load/vec4 v0000017710878bf0_0;
    %pad/s 3;
    %store/vec4 v0000017710878c90_0, 0, 3;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0000017710877b10_0, 0, 1;
    %wait E_0000017710885cd0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0000017710877b10_0, 0, 1;
    %vpi_call 2 285 "$display", "[%0t] Random Cabin Press: Floor=%0d", $time, v0000017710878bf0_0 {0 0 0};
    %end;
